# Copie para .env e preencha. Sem estas variáveis o robô roda em modo simulado (não envia e-mail, não chama IA).
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (conta Gmail do projeto)
# GROQ_API_KEY=            # só se provedor = "groq" no config.toml
SMTP_USER=                 # Gmail do projeto, ex.: radar.i9@gmail.com
SMTP_PASS=                 # senha de app (Conta Google → Segurança → Verificação em 2 etapas → Senhas de app)
# RADAR_SIMULAR_ENVIO=1    # descomente para nunca enviar e-mail de verdade neste PC
